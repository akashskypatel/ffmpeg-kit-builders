# Store text files as LF in Git and check them out as LF
* text=auto eol=lf

# Windows scripts require/prefer CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never modify binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.dll binary
*.dll.a binary
*.lib binary
*.exe binary
*.dylib binary
*.a binary
*.so binary