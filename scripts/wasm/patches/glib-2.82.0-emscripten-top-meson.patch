     glib_conf.set('HAVE_PTHREAD_GETAFFINITY_NP', 1)
   endif
 
@@ -2274,7 +2274,7 @@ if libintl.found() and libintl.type_name() != 'internal'
   #
   # Meson's builtin dependency lookup as of 0.60.0 doesn't check for
