# LSan-only third-party cleanup suppressions.
# Keep ASan interceptor rules out of this file: LSan rejects them and emits
# a parser error that would obscure sanitizer evidence.
# SDL keeps thread-local error buffers alive until process teardown.
leak:SDL_realloc_REAL
leak:SDL_SetError_REAL
leak:SDL_GetErrBuf
leak:SDL_DBus_Init
leak:SDL_Init
leak:SDL_InitSubSystem
leak:libX11
leak:libLLVM
leak:libGL
leak:libglapi
leak:libGLX_mesa
leak:<unknown module>
