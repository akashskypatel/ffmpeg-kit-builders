prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: FFmpegKit
Description: FFmpegKit provides programmatic access to FFmpeg, FFprobe, and FFplay from C or C++
Version: @VERSION@
Requires: 
Libs: -L${libdir} -lffmpegkit @FFMPEG_KIT_PLATFORM_LIBS@ FFMPEG_KIT_EXT_LIBS
Libs.private:
Cflags: -I${includedir} @FFMPEG_KIT_PLATFORM_CFLAGS@
