# Global Settings (Applies to all files)
CompileFlags:
  CompilationDatabase: "desktop"
  Add:
    - -I/home/vscode/ffmpeg-kit-builders/FFmpegKit/src
    - -I/home/vscode/ffmpeg-kit-builders/prebuilt/src/ffmpeg
    - -I/home/vscode/ffmpeg-kit-builders/prebuilt/src/jsoncpp/include
    - -I/home/vscode/ffmpeg-kit-builders/prebuilt/src/sdl2/include
    - -I/home/vscode/ffmpeg-kit-builders/FFmpegKit/build/_deps/googletest-src/googletest/include
    - -I/home/vscode/ffmpeg-kit-builders/FFmpegKit/build/_deps/googletest-src/googlemock/include
    - -I/Users/akash/Projects/ffmpeg-kit-builders/FFmpegKit/src
    - -I/Users/akash/Projects/ffmpeg-kit-builders/prebuilt/src/ffmpeg
    - -I/Users/akash/Projects/ffmpeg-kit-builders/prebuilt/src/jsoncpp/include
    - -I/Users/akash/Projects/ffmpeg-kit-builders/prebuilt/src/sdl2/include
    - -I/Users/akash/Projects/ffmpeg-kit-builders/FFmpegKit/build/_deps/googletest-src/googletest/include
    - -I/Users/akash/Projects/ffmpeg-kit-builders/FFmpegKit/build/_deps/googletest-src/googlemock/include
    - -I/Users/akash/Projects/ffmpeg-kit-builders/prebuilt/macos-aarch64/libraries/include
    - -I/Users/akash/Projects/ffmpeg-kit-builders/prebuilt/macos-x86_64/libraries/include
    - -I/Users/akash/Projects/ffmpeg-kit-builders/prebuilt/ios-aarch64/libraries/include
    - -I/Users/akash/Projects/ffmpeg-kit-builders/prebuilt/iphonesimulator-aarch64/libraries/include
    - -DDEBUG
    - -D_GNU_SOURCE
    - -D__STDC_CONSTANT_MACROS
    - -DFFMPEG_KIT_BUILD_DATE="20260209T000000Z"
    - -DFFMPEG_KIT_VERSION="1.0.0"
    - -DFFMPEG_KIT_BUNDLE_TYPE="custom"

Diagnostics:
  Suppress: ["main_file_non_preamble"]

# CompilationDatabase MUST be at the top level, not under CompileFlags
# This tells clangd where to look for compile_commands.json
Index:
  Background: Build

---
# Specific fix for C files
If:
  PathMatch: .*\.c
CompileFlags:
  Add: [-xc, -std=gnu17]

---
# Specific fix for C++ files (the wrapper)
If:
  PathMatch: .*\.(cpp|cc|hpp)
CompileFlags:
  Add: [-Wno-keyword-macro, -xc++, -std=c++17]